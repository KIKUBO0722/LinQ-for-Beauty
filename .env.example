# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=

# Auth (v0.1a)
# Generate with: openssl rand -hex 32
# production では 32 文字以上が必須 (main.ts が起動時に検証して短ければ起動拒否)
JWT_SECRET=

# 管理画面の初期ユーザー (seed 実行時のみ参照、Render 本体には不要)
# 両方設定して `pnpm --filter api seed` を実行すると users に upsert される。未設定なら warn でスキップ
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ★三点一致の不変条件 (admin 全画面の動作前提):
#   seed が投入する tenant の id = web ビルド時の NEXT_PUBLIC_TENANT_ID = ログインで発行される JWT の tenantId
# どれか 1 つでもズレると管理画面全ページが 403 になる。ズレた場合は env を揃えて web を再ビルド
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_API_URL=http://localhost:3333

# CORS (api が許可する web のオリジン)
CORS_ORIGIN=http://localhost:3000

# Timezone (必須 — slot 計算・日次集計が Asia/Tokyo 前提。main.ts が起動時に実測検証)
TZ=Asia/Tokyo

# ICS feed (Day 7-9)
# Generate with: openssl rand -hex 32
ICS_SECRET=
# Base URL used when generating ICS subscription URLs. Defaults to http://localhost:3333.
ICS_BASE_URL=http://localhost:3333

# App
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
